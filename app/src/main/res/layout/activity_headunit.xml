<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20F1012">

        <!-- Layer 1: Custom media (drawn first = behind everything) -->
        <ImageView
            android:id="@+id/loading_custom_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/loading_custom_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Layer 2: Default loading content ; roundabout: aa mark in a turning accent ring -->
        <LinearLayout
            android:id="@+id/loading_default_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="144dp"
                android:layout_height="144dp">

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/rb_accent" />

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/rb_ic_aa" />
            </FrameLayout>

            <TextView
                android:id="@+id/overlay_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:text="@string/android_auto_starting"
                android:textColor="@color/rb_text"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/overlay_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope_medium"
                android:gravity="center"
                android:maxWidth="520dp"
                android:textColor="@color/rb_muted"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/disconnect_button"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/rb_btn_tonal"
                android:fontFamily="@font/manrope_bold"
                android:minWidth="200dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="@string/shortcut_disconnect_title"
                android:textAllCaps="false"
                android:textColor="@color/rb_text"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Layer 3: Custom media status text (drawn last = on top of everything) -->
        <LinearLayout
            android:id="@+id/loading_custom_text_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="@android:color/white" />

            <TextView
                android:id="@+id/loading_custom_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/android_auto_starting"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:shadowColor="#AA000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
